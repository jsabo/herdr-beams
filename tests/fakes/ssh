#!/usr/bin/env bash
# Fake ssh for unit tests. Logs the call, then answers by the remote command.
# $FAKE_STATE/ssh-fail-count makes that many `true` probes fail first, which
# is how the wait-for-SSH loop is exercised.
set -euo pipefail
printf 'ssh %s\n' "$*" >> "$FAKE_LOG"

host=""
cmd=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) shift 2 ;;
    -*) shift ;;
    *)
      if [ -z "$host" ]; then host="$1"; shift; else cmd="$*"; break; fi
      ;;
  esac
done

if [[ "$cmd" == *"integration install"* ]] && [ -e "$FAKE_STATE/integration-fails" ]; then
  cat >/dev/null
  exit 1
fi

# The Beam-side setup program (plugin, settings and key block). The fake does
# not run it; beam-keys.bats runs it against a sandbox HOME instead.
if [[ "$cmd" == *"plugin config-dir herdr-beams"* ]]; then
  [ ! -e "$FAKE_STATE/keys-setup-fails" ] || { echo "fake ssh: plugin install failed on the Beam" >&2; exit 1; }
  exit 0
fi

case "$cmd" in
  *"codex app-server"*)
    printf '%s\n' '/home/beams/.codex'
    while IFS= read -r request; do
      printf '%s\n' "$request" >> "$FAKE_STATE/codex-rpc.log"
      method="$(jq -r '.method' <<<"$request")"
      case "$method" in
        initialize) printf '%s\n' '{"id":1,"result":{}}' ;;
        hooks/list)
          if [ -e "$FAKE_STATE/codex-rpc-error" ]; then
            printf '%s\n' '{"id":2,"error":{"code":-32601,"message":"hooks/list unsupported"}}'
          elif [ -f "$FAKE_STATE/codex-hooks.json" ]; then
            jq -c '{id:2,result:.}' "$FAKE_STATE/codex-hooks.json"
          else
            printf '%s\n' "{\"id\":2,\"result\":{\"data\":[{\"hooks\":[{\"key\":\"herdr-session\",\"eventName\":\"sessionStart\",\"handlerType\":\"command\",\"command\":\"bash '/home/beams/.codex/herdr-agent-state.sh' session\",\"sourcePath\":\"/home/beams/.codex/hooks.json\",\"enabled\":true,\"currentHash\":\"sha256:expected\"}]}]}}"
          fi ;;
        config/batchWrite)
          if [ -e "$FAKE_STATE/codex-write-error" ]; then
            printf '%s\n' '{"id":3,"error":{"message":"config is read-only"}}'
          else printf '%s\n' '{"id":3,"result":{}}'; fi ;;
      esac
    done
    exit 0 ;;
  true)
    f="$FAKE_STATE/ssh-fail-count"
    if [ -s "$f" ] && [ "$(cat "$f")" -gt 0 ]; then
      echo "$(( $(cat "$f") - 1 ))" > "$f"
      exit 255
    fi
    ;;
  *"beamctl list"*)
    cat "$FAKE_STATE/beamctl-list.txt" 2>/dev/null || true
    ;;
  *"beamctl logs"*)
    printf 'following: %s\n' "$cmd"
    ;;
  *" --version"*)
    cat >/dev/null
    printf 'herdr 0.0.0-fake\n'
    ;;
esac
exit 0
