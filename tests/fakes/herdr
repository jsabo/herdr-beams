#!/usr/bin/env bash
# Fake herdr for unit tests. Machine profiles live in $FAKE_STATE/machines.json;
# every call is appended to $FAKE_LOG, including the --machine prefix.
set -euo pipefail
printf 'herdr %s\n' "$*" >> "$FAKE_LOG"
machines="$FAKE_STATE/machines.json"

if [ "${1:-}" = --machine ]; then
  jq -e --arg selector "$2" 'any(.[]; .id == $selector or .label == $selector)' "$machines" >/dev/null \
    || { echo "fake herdr: unknown machine $2" >&2; exit 1; }
  shift 2
fi

case "${1:-} ${2:-}" in
  "machine list")
    [ ! -e "$FAKE_STATE/machine-list-fails" ] || exit 1
    cat "$machines"
    ;;
  "machine add")
    if [ -e "$FAKE_STATE/machine-add-fails" ]; then
      echo "error: no compatible herdr on the remote host" >&2
      exit 1
    fi
    target="$3"
    label="$5"
    # Profile ids are id-<beam id>, whatever the label prefix, so tests can
    # assert on `machine remove id-new-beam` without knowing the label form.
    pid="id-${label##*/}"
    jq --arg t "$target" --arg l "$label" --arg p "$pid" \
      '. + [{id: $p, label: $l, target: $t, session: "default", enabled: true, selected: false}]' \
      "$machines" > "$machines.tmp" && mv "$machines.tmp" "$machines"
    printf 'Saved SSH machine %s. Remote server is ready.\n' "$pid"
    ;;
  "machine rename")
    # herdr machine rename <profile-id> --label <label>; the real 0.9.3 binary
    # rejects --label first, so the fake is as strict.
    [ "${4:-}" = --label ] || { echo "usage: herdr machine rename <profile-id> --label <label>" >&2; exit 1; }
    jq --arg id "$3" --arg l "$5" 'map(if .id == $id then .label = $l else . end)' \
      "$machines" > "$machines.tmp" && mv "$machines.tmp" "$machines"
    printf 'Renamed SSH machine %s.\n' "$3"
    ;;
  "machine remove")
    [ ! -e "$FAKE_STATE/machine-remove-fails" ] || exit 1
    jq --arg id "$3" 'map(select(.id != $id))' "$machines" > "$machines.tmp" && mv "$machines.tmp" "$machines"
    printf 'Removed SSH machine %s.\n' "$3"
    ;;
  "workspace list")
    [ ! -e "$FAKE_STATE/workspace-list-fails" ] || exit 1
    cat "$FAKE_STATE/workspaces.json"
    ;;
  "workspace rename")
    # herdr workspace rename <workspace-id> <label...>: the label is positional,
    # unlike machine rename, which takes --label.
    [ ! -e "$FAKE_STATE/workspace-rename-fails" ] || exit 1
    [ "$#" -ge 4 ] || { echo "usage: herdr workspace rename <workspace-id> <label>" >&2; exit 1; }
    jq --arg id "$3" --arg l "${*:4}" 'if .result.workspaces | any(.workspace_id == $id)
        then .result.workspaces |= map(if .workspace_id == $id then .label = $l else . end)
        else .result.workspaces += [{ workspace_id: $id, label: $l }] end' \
      "$FAKE_STATE/workspaces.json" > "$FAKE_STATE/workspaces.tmp" \
      && mv "$FAKE_STATE/workspaces.tmp" "$FAKE_STATE/workspaces.json"
    printf '{"id":"cli:workspace:rename","result":{"type":"ok"}}\n'
    ;;
  "workspace create")
    if [ -f "$FAKE_STATE/workspace-response.json" ]; then
      cat "$FAKE_STATE/workspace-response.json"
      exit 0
    fi
    printf '{"id":"cli:workspace:create","result":{"root_pane":{"pane_id":"w9:p1","workspace_id":"w9"},"workspace":{"workspace_id":"w9"},"type":"workspace_created"}}\n'
    ;;
  "agent list")
    [ ! -e "$FAKE_STATE/agent-list-fails" ] || exit 1
    if [ -f "$FAKE_STATE/agent-list-response.json" ]; then
      cat "$FAKE_STATE/agent-list-response.json"
      exit 0
    fi
    # Names in $FAKE_STATE/agent-names (one per line) are already taken.
    names='[]'
    if [ -s "$FAKE_STATE/agent-names" ]; then
      names="$(jq -R . "$FAKE_STATE/agent-names" | jq -s 'map({name: .})')"
    fi
    printf '{"id":"cli:agent:list","result":{"agents":%s}}\n' "$names"
    ;;
  "pane run")
    [ ! -e "$FAKE_STATE/pane-run-fails" ] || exit 1
    [ "$#" -eq 4 ] || { echo 'usage: herdr pane run <pane-id> <command>' >&2; exit 1; }
    printf '%s' "$4" > "$FAKE_STATE/last-pane-command"
    printf '{"result":{}}\n'
    ;;
  "workspace report-metadata")
    [ ! -e "$FAKE_STATE/report-metadata-fails" ] || exit 1
    printf '{"id":"cli:workspace:report-metadata","result":{}}\n'
    ;;
  "agent start")
    printf '%s\0' "$@" > "$FAKE_STATE/last-agent-argv"
    printf '{"id":"cli:agent:start","result":{"agent":{"name":"%s","agent_status":"idle","pane_id":"w9:p1"},"type":"agent_started"}}\n' "$3"
    ;;
  "agent prompt")
    printf '{"id":"cli:agent:prompt","result":{"agent":{"name":"%s","agent_status":"done"},"type":"agent_prompted"}}\n' "$3"
    ;;
  "agent wait")
    printf '{"id":"cli:agent:wait","result":{"agent":{"name":"%s","agent_status":"done"},"type":"agent_waited"}}\n' "$3"
    ;;
  "agent read")
    printf '> curl -s localhost:8080/api/time\n{"utc": "2030-01-01T00:00:00Z"}\n\ndone\n'
    ;;
  "plugin pane")
    printf '{"id":"cli:plugin:pane:open","result":{"pane_id":"w1:p9"},"type":"plugin_pane_opened"}\n'
    ;;
  # The next four are what the Beam-side setup program calls. A test can run
  # that program against a sandbox HOME with these on PATH, which is how the
  # remote half is covered without a Beam.
  "plugin list")
    if [ -e "$FAKE_STATE/plugin-not-installed" ]; then
      printf '0 plugins installed:\n'
    else
      printf -- '- herdr-beams (Teleport Beams) enabled [github:jsabo/herdr-beams]\n'
    fi
    ;;
  "plugin install")
    # The real binary prints its whole manifest preview to stderr, even when it
    # succeeds; the setup program has to keep that out of the popup.
    printf 'Plugin install preview:\n  id: herdr-beams\n  actions: 11\n' >&2
    [ ! -e "$FAKE_STATE/plugin-install-fails" ] || { echo "fake herdr: install failed" >&2; exit 1; }
    printf 'Installed herdr-beams from %s.\n' "$3"
    ;;
  "plugin config-dir")
    printf '%s\n' "${HERDR_PLUGIN_CONFIG_DIR:-$HOME/.config/herdr/plugins/config/$3}"
    ;;
  "server reload-config")
    [ ! -e "$FAKE_STATE/reload-config-fails" ] || exit 1
    printf 'Reloaded configuration.\n'
    ;;
  "integration install")
    [ ! -e "$FAKE_STATE/integration-fails" ] || exit 1
    printf 'Installed the %s integration.\n' "$3"
    ;;
  *)
    echo "fake herdr: unsupported: $*" >&2
    exit 2
    ;;
esac
